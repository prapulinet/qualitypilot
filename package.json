{
  "name": "qualitypilot",
  "version": "1.3.0",
  "private": true,
  "description": "Evidence-first QA portfolio with a deterministic test workbench and optional AI scenario adapter",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node tools/check-syntax.js",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:capture": "node tools/capture-preview.js",
    "audit:ui": "node tools/audit-ui.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
